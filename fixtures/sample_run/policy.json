        "body": {
          "not_contains_class": [
            "bank",
            "medical",
            "personal",
            "financial",
            "identity"
          ]
        }
      }
    },
    "flow_rules": [
      {
        "id": "FR1",
        "when": "context.untrusted",
        "sinks": [
          "email.*",
